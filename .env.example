# Neon Postgres — @neondatabase/serverless HTTP 드라이버용 connection string
# (PRD §10-3②: pooled string 또는 HTTP 드라이버 중 하나는 반드시 사용해야 함. 여기선 HTTP 드라이버 사용.)
DATABASE_URL=

# Auth.js(NextAuth) — 세션 서명용 시크릿. `npx auth secret`으로 생성 가능
AUTH_SECRET=

# 카카오 로컬 API(키워드 장소 검색) — 서버(Route Handler)에서만 사용, 클라이언트에 노출 금지
# 카카오 디벨로퍼스에서 발급받는 REST API 키 1개 (네이버처럼 client id/secret 쌍이 아님)
KAKAO_REST_API_KEY=

# Gmail SMTP(이메일 발송) — 전북대 이메일(@jbnu.ac.kr) 회원가입 인증번호 발송용.
# 소유 도메인 없이도 임의 수신자에게 보낼 수 있어 Resend 샌드박스 제약을 피하려고 채택했다.
# GMAIL_USER: 발신용 Gmail 주소. GMAIL_APP_PASSWORD: 해당 계정에 2단계 인증을 켠 뒤
# https://myaccount.google.com/apppasswords 에서 발급받는 16자리 앱 비밀번호(계정 로그인 비밀번호 아님).
GMAIL_USER=
GMAIL_APP_PASSWORD=

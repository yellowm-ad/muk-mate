# 먹메이트(MukMate) 환경변수 템플릿
#
# 실제 값은 여기에 채우지 않는다. 로컬 개발은 이 파일을 .env.local로 복사한 뒤
# 값을 채운다 (.env.local은 .gitignore 대상이라 커밋되지 않는다).
# 배포 환경 값은 Vercel 프로젝트의 Production/Preview/Development 환경변수로 등록한다
# (`/vercel-env` 참고). 코드에 하드코딩하지 않는다.

# Neon DB pooled connection string (PgBouncer 경유). 절대 direct connection 문자열을 쓰지 않는다.
# 예: postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=

# Auth.js(NextAuth) 세션/토큰 서명용 비밀키. `openssl rand -base64 32` 등으로 생성.
NEXTAUTH_SECRET=

# 네이버 개발자센터 애플리케이션 Client ID/Secret (지역 검색 API, Maps API)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
